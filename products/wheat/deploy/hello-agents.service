[Unit]
Description=YOLOv8-Agent HelloAgents Platform (Gradio UI)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/hello-agents
# 主配置（.env：LLM key / Qdrant / Neo4j / 嵌入方案）
EnvironmentFile=/opt/hello-agents/.env
# UI 登录保护（由 server_setup.sh 生成 /etc/hello-agents-ui.env）
EnvironmentFile=/etc/hello-agents-ui.env
Environment=HELLO_AGENTS_UI_HOST=0.0.0.0
Environment=HELLO_AGENTS_UI_PORT=7865
Environment=HELLO_AGENTS_UI_INBROWSER=0
# 外部视觉系统镜像目录（best.pt / best.onnx / 评估CSV）
Environment=AGRICULTURE_SYSTEM_DIR=/opt/hello-agents/xiaomai
ExecStart=/opt/hello-agents/venv/bin/python run_ui.py
Restart=always
RestartSec=5
# Gradio 启动慢（加载 torch/ultralytics），给足时间
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target

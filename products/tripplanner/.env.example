# 默认启动可直接使用演示模式，无需任何密钥。
# 前后端统一读取本产品 .env；已有进程环境变量优先级最高。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_ID=deepseek-chat
AMAP_API_KEY=
# 可选，仅真实模式：为每天首个景点搜索一张灵感图片。
UNSPLASH_ACCESS_KEY=
TRIPPLANNER_HOST=127.0.0.1
TRIPPLANNER_PORT=8007
# 可选浏览器地图配置；仅 VITE_ 前缀变量会进入前端构建。
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_CODE=

{
  "model_name": "Qwen/Qwen3-0.6B",
  "algorithm": "grpo",
  "output_dir": "./models/ch11_pipeline",
  "dataset": "gsm8k",
  "format": "rl",
  "split": "train",
  "max_samples": 100,
  "num_epochs": 2,
  "batch_size": 1,
  "learning_rate": 1e-5,
  "use_lora": true,
  "lora_r": 8,
  "lora_alpha": 16,
  "max_length": 512,
  "num_generations": 4,
  "max_new_tokens": 128,
  "temperature": 0.8,
  "kl_coef": 0.05,
  "clip_range": 0.2,
  "reward_type": "combined",
  "reward_config": {
    "components": [
      { "type": "accuracy", "weight": 1.0 },
      { "type": "length_penalty", "weight": 0.5, "target_length": 200 },
      { "type": "step", "weight": 0.3, "step_bonus": 0.1 }
    ]
  },
  "evaluate": {
    "max_samples": 20,
    "use_lora": true
  }
}
